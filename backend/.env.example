# Environment variables must be set in your shell or hosting dashboard.
# Spring Boot does not automatically load this file.
SPRING_PROFILES_ACTIVE=prod
PORT=8080
DB_URL=jdbc:postgresql://YOUR_AIVEN_HOST:YOUR_PORT/defaultdb?sslmode=verify-full&sslrootcert=/path/to/aiven-ca.pem
DB_USERNAME=YOUR_DATABASE_USER
DB_PASSWORD=REPLACE_LOCALLY
APP_CORS_ALLOWED_ORIGINS=https://YOUR_PROJECT.pages.dev
# Same high-entropy secret in Render and Cloudflare Worker; backend prod requires it.
ORIGIN_PROXY_SECRET=REPLACE_WITH_RANDOM_32_OR_MORE_CHARACTERS
# Create only if the email does not already exist. Remove bootstrap variables after first startup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Google login stays disabled until real credentials and callback URL are configured.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR_PUBLIC_GATEWAY/api/v1/auth/oauth2/callback/google

# Required in production. Base64 of at least 32 cryptographically random bytes; keep outside Git.
JWT_SECRET=
# Recovery stays disabled until the HTTPS mail provider and verified sender are configured.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_PUBLIC_ORIGIN=https://YOUR_PROJECT.pages.dev
RESEND_API_KEY=
MAIL_FROM=
