NODE_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:4200
TURSO_DATABASE_URL=file:local.sqlite
# Remote production uses libsql://... and a database-scoped token, never the platform login token.
TURSO_AUTH_TOKEN=
JWT_SECRET=
ORIGIN_PROXY_SECRET=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional Azure card-image storage (takes precedence over R2). Never commit real SAS.
# AZURE_STORAGE_CONTAINER_URL=https://account.blob.core.windows.net/card-images
# AZURE_STORAGE_SAS_TOKEN=container-scoped-https-create-write-SAS

# Board-game assistant (login required). Providers are tried in AI_PROVIDER_ORDER; missing
# credentials are skipped. Keep all provider keys server-side, never in the frontend.
# Admin-managed keys are stored encrypted with AES-256-GCM. This master key must be Base64 for
# exactly 32 random bytes and must never change once keys exist. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave empty to disable admin key management; env credentials below still work.
ASSISTANT_KEY_SECRET=
# motapis (MộtAPI) is paid per token, so it sits last: it only answers after the free tiers fail.
AI_PROVIDER_ORDER=workers-ai,gemini,groq,openrouter,motapis
# Multiple credentials per provider are comma/newline separated. Each becomes a numbered slot
# (#1, #2...) with its own cooldown, so an exhausted key fails over to the next key automatically.
CLOUDFLARE_AI_ACCOUNTS=
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
MOTAPIS_API_KEYS=
# A value in CLOUDFLARE_AI_ACCOUNTS is "accountId:apiToken".
# Singular variables below still work and are appended after the plural list.
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_SITE_URL=http://localhost:4200
# MộtAPI key from https://motapis.com (sk-...). Paid per token; admins can store the same key in the
# assistant key screen instead of here.
MOTAPIS_API_KEY=
MOTAPIS_MODEL=claude-sonnet-5
# One attempt gets this much of AI_TIMEOUT_MS. Live probes on 2026-10-29 saw motapis answer in
# 5-20 s, so the default 7 s usually cuts the paid fallback off before it replies.
AI_TIMEOUT_MS=30000
AI_ATTEMPT_TIMEOUT_MS=7000
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3
