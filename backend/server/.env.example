NODE_ENV=development
PORT=8080
PUBLIC_ORIGIN=http://localhost:4200
TURSO_DATABASE_URL=file:local.sqlite
# Remote production uses libsql://... and a database-scoped token, never the platform login token.
TURSO_AUTH_TOKEN=
JWT_SECRET=
ORIGIN_PROXY_SECRET=
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
MAIL_FROM=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional Azure card-image storage (takes precedence over R2). Never commit real SAS.
# AZURE_STORAGE_CONTAINER_URL=https://account.blob.core.windows.net/card-images
# AZURE_STORAGE_SAS_TOKEN=container-scoped-https-create-write-SAS

# Optional public board-game assistant. Providers are tried in AI_PROVIDER_ORDER; missing
# credentials are skipped. Keep all provider keys server-side, never in the frontend.
AI_PROVIDER_ORDER=workers-ai,gemini,groq,openrouter
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=http://localhost:4200
AI_TIMEOUT_MS=30000
AI_ATTEMPT_TIMEOUT_MS=7000
AI_MAX_OUTPUT_TOKENS=700
AI_TEMPERATURE=0.3
