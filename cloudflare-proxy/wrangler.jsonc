{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exe-webapp-gateway",
  "account_id": "345623adea5a4542fb1ba24b89fa3b56",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/30 * * * *"] },
  "vars": {
    "PUBLIC_ORIGIN": "https://exe-webapp.pages.dev",
    "BACKEND_ORIGIN": "https://exe-web-backend.onrender.com",
    "FRONTEND_ORIGIN": "https://exe-webapp.pages.dev"
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "257200511", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "257200512", "simple": { "limit": 5, "period": 60 } },
    { "name": "ACCOUNT_LIMITER", "namespace_id": "257200513", "simple": { "limit": 10, "period": 60 } }
  ]
}
