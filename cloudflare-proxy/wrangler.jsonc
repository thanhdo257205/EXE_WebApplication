{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exe-web-api-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://YOUR_GATEWAY.YOUR_SUBDOMAIN.workers.dev",
    "BACKEND_ORIGIN": "https://YOUR_BACKEND.onrender.com",
    "FRONTEND_ORIGIN": "https://YOUR_FRONTEND.pages.dev"
  },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "257200501", "simple": { "limit": 120, "period": 60 } },
    { "name": "LOGIN_LIMITER", "namespace_id": "257200502", "simple": { "limit": 5, "period": 60 } },
    { "name": "ACCOUNT_LIMITER", "namespace_id": "257200503", "simple": { "limit": 10, "period": 60 } }
  ]
}
