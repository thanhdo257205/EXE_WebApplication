# The SPA fallback in _redirects serves index.html for every route, so the document path is the
# only place a framing policy can be attached. The gateway's Origin/Sec-Fetch gates cannot tell a
# framed document from a tab: an embedded page sends same-origin values by construction.
# Same intent as the payment-return document (backend/server/src/payments.ts).
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
/assets/fonts/*
  Cache-Control: public, max-age=2592000
/assets/models/*
  Cache-Control: public, max-age=2592000
/assets/cards/*
  Cache-Control: public, max-age=2592000
/assets/images/*
  Cache-Control: public, max-age=2592000
# JS/CSS do Angular build có hash trong tên file (outputHashing: all): nội dung đổi thì tên đổi, nên cache vĩnh viễn được.
/*.js
  Cache-Control: public, max-age=31536000, immutable
/styles-*.css
  Cache-Control: public, max-age=31536000, immutable
