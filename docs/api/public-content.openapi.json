{
  "openapi": "3.1.0",
  "info": {
    "title": "Public content API",
    "version": "1.0.0",
    "description": "Read-only content. No login required; production uses same-origin gateway and origin proxy guard. No publication or deployment mutations. No current release returns 404. Markdown must be sanitized by the consumer. See docs/PUBLIC_CONTENT_API.md for budgets and static export."
  },
  "servers": [
    {
      "url": "/api/v1/content"
    }
  ],
  "security": [],
  "paths": {
    "/release": {
      "get": {
        "operationId": "getPublicRelease",
        "summary": "Read allowlisted public release metadata",
        "parameters": [
          {
            "name": "releaseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Omit for current published release; explicit IDs must have been published (PUBLISHED or ARCHIVED with publishedAt). Drafts always return 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Public content; Cache-Control public, max-age=60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Release"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published content not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Read budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/snapshot": {
      "get": {
        "operationId": "getPublicSnapshot",
        "summary": "Export one public release for static delivery",
        "parameters": [
          {
            "name": "releaseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Omit for current published release; explicit IDs must have been published (PUBLISHED or ARCHIVED with publishedAt). Drafts always return 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Public content; Cache-Control public, max-age=60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published content not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Read budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/{kind}": {
      "get": {
        "operationId": "listPublicContent",
        "summary": "Search and page public content",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "characters",
                "card-sets",
                "cards",
                "wiki-pages"
              ]
            }
          },
          {
            "name": "releaseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Omit for current published release; explicit IDs must have been published (PUBLISHED or ARCHIVED with publishedAt). Drafts always return 404."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 12,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100,
              "default": ""
            },
            "description": "Substring in name/title/code/slug; Vietnamese accent and case insensitive; literal wildcard characters."
          },
          {
            "name": "cardSetId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cards only"
          },
          {
            "name": "characterId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cards only"
          },
          {
            "name": "pageType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "STORY",
                "RULE",
                "GUIDE",
                "FAQ",
                "DEVLOG"
              ]
            },
            "description": "Wiki pages only"
          }
        ],
        "responses": {
          "200": {
            "description": "Public content; Cache-Control public, max-age=60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Listing"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published content not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Read budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/{kind}/{slug}": {
      "get": {
        "operationId": "getPublicContentBySlug",
        "summary": "Read public content by stable slug",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "characters",
                "card-sets",
                "cards",
                "wiki-pages"
              ]
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 160,
              "pattern": "[a-zA-Z0-9_-]+"
            }
          },
          {
            "name": "releaseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Omit for current published release; explicit IDs must have been published (PUBLISHED or ARCHIVED with publishedAt). Drafts always return 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Public content; Cache-Control public, max-age=60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published content not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Read budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/{kind}/by-id/{id}": {
      "get": {
        "operationId": "getPublicContentById",
        "summary": "Read public content by stable UUID",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "characters",
                "card-sets",
                "cards",
                "wiki-pages"
              ]
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "releaseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Omit for current published release; explicit IDs must have been published (PUBLISHED or ARCHIVED with publishedAt). Drafts always return 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Public content; Cache-Control public, max-age=60",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Detail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published content not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Read budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Release": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "versionLabel",
          "title",
          "publishedAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "versionLabel": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Character": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "sortOrder",
          "code",
          "name",
          "biography",
          "abilityText",
          "portraitUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "biography": {
            "type": "string"
          },
          "abilityText": {
            "type": [
              "string",
              "null"
            ]
          },
          "portraitUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CardSet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "sortOrder",
          "code",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Card": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "sortOrder",
          "code",
          "cardSetId",
          "characterId",
          "name",
          "effectText",
          "rulingNotes",
          "ruleStatus",
          "copiesInDeck",
          "artworkUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "cardSetId": {
            "type": "string",
            "format": "uuid"
          },
          "characterId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "effectText": {
            "type": "string"
          },
          "rulingNotes": {
            "type": [
              "string",
              "null"
            ]
          },
          "ruleStatus": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "NEEDS_REVIEW"
            ]
          },
          "copiesInDeck": {
            "type": "integer",
            "minimum": 1
          },
          "artworkUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WikiPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "sortOrder",
          "pageType",
          "title",
          "summary",
          "bodyMarkdown",
          "ruleStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "pageType": {
            "type": "string",
            "enum": [
              "STORY",
              "RULE",
              "GUIDE",
              "FAQ",
              "DEVLOG"
            ]
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "bodyMarkdown": {
            "type": "string"
          },
          "ruleStatus": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "NEEDS_REVIEW"
            ]
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Character"
                },
                {
                  "$ref": "#/components/schemas/CardSet"
                },
                {
                  "$ref": "#/components/schemas/Card"
                },
                {
                  "$ref": "#/components/schemas/WikiPage"
                }
              ]
            }
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "totalElements": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Listing": {
        "type": "object",
        "required": [
          "release",
          "result"
        ],
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "result": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "Detail": {
        "type": "object",
        "required": [
          "release",
          "item"
        ],
        "properties": {
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "item": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Character"
              },
              {
                "$ref": "#/components/schemas/CardSet"
              },
              {
                "$ref": "#/components/schemas/Card"
              },
              {
                "$ref": "#/components/schemas/WikiPage"
              }
            ]
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "release",
          "content"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "release": {
            "$ref": "#/components/schemas/Release"
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "characters",
              "card-sets",
              "cards",
              "wiki-pages"
            ],
            "properties": {
              "characters": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Character"
                }
              },
              "card-sets": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/CardSet"
                }
              },
              "cards": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Card"
                }
              },
              "wiki-pages": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/WikiPage"
                }
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  }
}
