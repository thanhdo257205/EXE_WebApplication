  "narrative": {
    "northStar": "Diet Soda-inspired board-game showcase",
    "overview": "A Diet Soda-inspired public identity for the Vietnamese board game Nhà Này Hơi Báo!: oversized product typography, italic emphasis, a near-black interactive hero and bright supporting surfaces and tangible box-and-card illustration. Dark liquid-glass navigation connects the ambient homepage; account and legal panels retain light reading surfaces. The exact Column Spread engine remains unchanged.\n\nPublic content, account and legal screens share this palette. The existing dark admin workspace remains an Operate surface; it shares the requested heading entrance without adopting the public layout. The card library, character directory and wiki read published content; the fund simulator and shop remain unfinished. Decorative cards are illustrations, not official game content.",
    "keyCharacteristics": [
      "Oversized Vietnamese headings with contrasting italic emphasis.",
      "Dark liquid-glass navigation and one continuous homepage ground with shared theme accents.",
      "Physical product illustration above a dark canvas showcase.",
      "Static body copy, spring headings and accessible reduced-motion states."
    ],
    "rules": [
      {
        "name": "The Static Reading Rule",
        "body": "Body paragraphs stay static; the requested Rise & Settle treatment belongs to semantic headings.",
        "section": "typography"
      },
      {
        "name": "The Illustration Rule",
        "body": "Decorative card faces and the box mockup must remain visibly identified as illustrations.",
        "section": "components"
      }
    ],
    "dos": [
      "Do preserve Vietnamese product names and explicit illustration labels.",
      "Do import RiseHeadingDirective into new components containing headings.",
      "Do keep body paragraphs static and reduced-motion headings readable.",
      "Do retain clear unfinished-content notices on placeholder destinations.",
      "Do keep the admin workspace visually scoped to its existing dark theme."
    ],
    "donts": [
      "Don’t present decorative cards as official rules or product artwork.",
      "Don’t alter the supplied Column Spread mathematics, parameters, image order or draw order.",
      "Don’t replace the requested heading springs with CSS keyframes or another motion engine.",
      "Don’t imply that local visual verification proves deployment or real authentication."
    ]
  }
}
